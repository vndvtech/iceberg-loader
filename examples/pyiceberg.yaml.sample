# Sample pyiceberg.yaml configuration for REST Catalog
#
# Copy this file to ~/.pyiceberg.yaml and adjust the values.
# Then load the catalog with:
#   from pyiceberg.catalog import load_catalog
#   catalog = load_catalog("my-rest-catalog")
#
# For more details see: https://py.iceberg.apache.org/configuration/

catalog:
  my-rest-catalog:
    # Catalog type — use "rest" for any Iceberg REST Catalog server
    # (Tabular, Apache Polaris, self-hosted, etc.)
    type: rest

    # REST Catalog server endpoint
    uri: https://api.tabular.io/ws

    # Warehouse location (S3 bucket path)
    warehouse: s3://my-bucket/warehouse/

    # OAuth2 credential (from your catalog provider)
    credential: your-oauth2-credential-here

    # S3 filesystem properties for direct data access
    s3.endpoint: https://s3.amazonaws.com
    s3.region: us-east-1
    # s3.access-key-id: AKIAIOSFODNN7EXAMPLE
    # s3.secret-access-key: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

  # Example: local MinIO with the bundled Apache Polaris REST catalog.
  # `warehouse` is the Polaris catalog name (not an S3 URI); the catalog's
  # base location is configured server-side via the Management API.
  local-polaris:
    type: rest
    uri: http://localhost:8181/api/catalog
    warehouse: datalake
    credential: root:root
    scope: PRINCIPAL_ROLE:ALL
    # Disable vended credentials (Polaris rejects the delegation request for a
    # plain root principal); the static S3 keys below are used instead.
    header.X-Iceberg-Access-Delegation: ""
    s3.endpoint: http://localhost:9000
    s3.access-key-id: minio
    s3.secret-access-key: minio123
    s3.path-style-access: "true"
    s3.region: us-east-1
